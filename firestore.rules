rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public requests collection for citizen CCTV and public service requests
    match /requests/{requestId} {
      allow read, write: if true;
    }

    // Archives collection for long-term storage of completed requests older than 90 days
    match /archives/{archiveId} {
      allow read, write: if true;
    }

    // CCTV Cameras collection
    match /cctv_cameras/{cameraId} {
      allow read, write: if true;
    }

    // CCTV Equipment & Peripheral Asset Registry
    match /cctv_equipment/{equipmentId} {
      allow read, write: if true;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // User profiles
    match /user_profiles/{profileId} {
      allow read, write: if true;
    }

    // User accounts authenticated via Firebase Auth
    match /users/{userId} {
      allow read, write: if true;
    }

    // Fallback for subcollections and other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


